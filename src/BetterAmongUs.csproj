<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OutputType>Library</OutputType>
		<LangVersion>preview</LangVersion>
		<Configurations>Debug;Release;Beta</Configurations>
		<AssemblyName>GreaterAmongUs</AssemblyName>
		<RootNamespace>BetterAmongUs</RootNamespace>
		<!-- Reproducible build: no machine paths (C:\Users\...) end up in the DLL/PDB. -->
		<Deterministic>true</Deterministic>
		<PathMap>$(MSBuildProjectDirectory)=.</PathMap>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<!-- Apply Null Notation Restrictions -->
	<Target Name="Il2CppRestrictions" BeforeTargets="CoreCompile" Condition="$([MSBuild]::IsOsPlatform(Windows))">
		<Exec Command="powershell.exe -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\Il2CppRestrictions.ps1&quot;" IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="ScriptExitCode" />
		</Exec>

		<Error Condition="'$(ScriptExitCode)' != '0'" Text="Il2Cpp compatibility check failed. See errors in error list." />
	</Target>

	<!-- Generate Translation Strings -->
	<PropertyGroup>
		<TranslationKeysClassName>TranslationStrings</TranslationKeysClassName>
		<TranslationJsonPath>$(MSBuildProjectDirectory)\Resources\Lang\en_US.json</TranslationJsonPath>
		<GeneratedOutputDir>$(MSBuildProjectDirectory)\build\Generated</GeneratedOutputDir>
	</PropertyGroup>

	<!-- Windows only (PowerShell). The generated file is committed, so other platforms just use it. -->
	<Target Name="GenerateTranslationKeys" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::IsOsPlatform(Windows))">
		<MakeDir Directories="$(GeneratedOutputDir)" Condition="!Exists('$(GeneratedOutputDir)')" />

		<Exec Command="powershell.exe -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\GenerateTranslationStrings.ps1&quot; -JsonPath &quot;$(TranslationJsonPath)&quot; -OutputPath &quot;$(GeneratedOutputDir)\$(TranslationKeysClassName).cs&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;" IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="ScriptExitCode" />
		</Exec>

		<Error Condition="'$(ScriptExitCode)' != '0'" Text="Translation key generation failed. See errors in error list." />
	</Target>

	<Target Name="CleanTranslationKeys" AfterTargets="Clean" Condition="$([MSBuild]::IsOsPlatform(Windows))">
		<Delete Files="$(GeneratedOutputDir)\$(TranslationKeysClassName).cs" />
	</Target>

	<!-- Build Metadata -->
	<PropertyGroup>
		<BuildDate>$([System.DateTime]::Now.ToString("MM.dd.yyyy"))</BuildDate>
	</PropertyGroup>

	<!-- Assembly metadata read at runtime by BAUPlugin.ModInfo (no GitInfo / ThisAssembly packages needed). -->
	<ItemGroup>
		<AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
		<AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
	</ItemGroup>

	<!-- Short commit hash (optional; empty when git is not installed or this is not a clone). -->
	<Target Name="AddCommitHashMetadata" BeforeTargets="GetAssemblyAttributes;CoreGenerateAssemblyInfo">
		<Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
			<Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
		</Exec>
		<ItemGroup Condition="'$(GitExitCode)' == '0'">
			<AssemblyMetadata Include="CommitHash" Value="$(GitCommitHash)" />
		</ItemGroup>
	</Target>

	<!-- Game Path Configuration -->
	<PropertyGroup>
		<CopyToGame Condition="'$(CopyToGame)' == ''">true</CopyToGame>
		<ModPathFile>build\mod_folder_path</ModPathFile>
	</PropertyGroup>

	<!-- Target to read game path (only if CopyToGame is true) -->
	<Target Name="ReadGamePath">
		<PropertyGroup>
			<GamePath Condition="Exists('$(ModPathFile)')">
				$([System.IO.File]::ReadAllText('$(ModPathFile)').Trim())
			</GamePath>
		</PropertyGroup>
		<Message Text="Game path read: $(GamePath)" Condition="'$(GamePath)' != ''" Importance="low" />
	</Target>

	<!-- Copy Mod to Game Folder -->
	<Target Name="CopyModToGame" AfterTargets="PostBuildEvent" Condition="'$(CopyToGame)' == 'true'" DependsOnTargets="ReadGamePath">

		<Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(GamePath)" SkipUnchangedFiles="true" Condition="'$(GamePath)' != '' and Exists('$(GamePath)')">
			<Output TaskParameter="CopiedFiles" ItemName="CopiedMods" />
		</Copy>

		<Message Text="Successfully copied mod to: $(GamePath)" Importance="high" Condition="'@(CopiedMods)' != ''" />

		<Warning Text="Game path not found. Create $(ModPathFile) with game folder path." Condition="'$(CopyToGame)' == 'true' and ('$(GamePath)' == '' or !Exists('$(GamePath)'))" />
	</Target>

	<!--
	  Game assemblies. Two ways to build:
	    1) Default: the AmongUs.GameLibs.Steam NuGet package (2026.9.29 = current 64-bit game).
	    2) Your own game's interop folder (for a game update before the package exists):
	         dotnet build -c Release -p:InteropDir="C:\Program Files (x86)\Steam\steamapps\common\Among Us\BepInEx\interop"
	       (start Among Us once with BepInEx so the interop folder is generated)
	-->
	<ItemGroup Condition="'$(InteropDir)' != ''">
		<Reference Include="$(InteropDir)\*.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- NuGet Core Packages -->
	<ItemGroup>
		<PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" Condition="'$(InteropDir)' == ''" />
		<PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.0.1" Condition="'$(InteropDir)' == ''">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
		<PackageReference Include="Costura.Fody" Version="5.8.0-alpha0098">
			<IncludeAssets>runtime; compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<!-- NuGet Info Packages -->
	<ItemGroup>
		<PackageReference Include="Semver" Version="3.0.0" />
	</ItemGroup>

	<!-- Embedded Resources -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\**\*" />
	</ItemGroup>
</Project>